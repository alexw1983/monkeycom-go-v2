package fragments

import (
	"github.com/alexw1983/monkeycom-go-v2/models"
	"strconv"
)

templ Roll(r models.SkillRoll) {
	<p>D20 = { strconv.Itoa(r.DiceRoll) }</p>
	<p>+  { r.Ability } ( { strconv.Itoa(r.AbilityModifier ) } ) </p>
	if r.Proficient {
		<p>+ Proficiency Bonus ( { strconv.Itoa(r.ProficiencyBonus ) } ) </p>
	}
	if r.Expertise {
		<p>+ Expertise Bonus ( { strconv.Itoa(r.ProficiencyBonus ) } ) </p>
	}
	<p>Total = { strconv.Itoa(r.Total()) }</p>
	<hr/>
}
